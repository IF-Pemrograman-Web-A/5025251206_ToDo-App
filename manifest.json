{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Citadel Todo - The Offline Abyss",
  "short_name": "Citadel Todo",
  "description": "Iron Citadel Organizational & Personal Todo App with full Offline Abyss PWA support.",
  "id": "./index.php",
  "start_url": "./index.php",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f5f0",
  "theme_color": "#2c4230",
  "lang": "id",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Personal Tasks",
      "short_name": "Personal",
      "description": "Buka daftar tugas personal",
      "url": "./index.php?view=personal",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Shared Tasks",
      "short_name": "Shared",
      "description": "Buka daftar tugas organisasi & shared",
      "url": "./index.php?view=shared",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}
