              "raw": "{\n  \"title\": \"Update Tanpa ID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/todos.php",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"]
            },
            "description": "Melakukan request PUT tanpa menyertakan parameter ID. Menghasilkan HTTP 400 Bad Request."
          }
        },
        {
          "name": "2.7 DELETE Todo - 404 Not Found (Non-Existent ID)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos.php?id=77777",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"],
              "query": [
                {
                  "key": "id",
                  "value": "77777"
                }
              ]
            },
            "description": "Mencoba menghapus ID yang tidak ada di database. Menghasilkan HTTP 404 Not Found."
          }
        },
        {
          "name": "2.8 DELETE Todo - 400 Bad Request (Missing ID)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos.php",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"]
            },
