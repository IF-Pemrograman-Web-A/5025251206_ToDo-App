          }
        }
      ]
    },
    {
      "name": "3. Authentication Tests (401 Unauthorized vs Valid)",
      "item": [
        {
          "name": "3.1 Missing API Key (401 Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos.php",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"]
            },
            "description": "Mengirim request tanpa menyertakan API Key. Menghasilkan respon HTTP 401 Unauthorized."
          }
        },
        {
          "name": "3.2 Wrong API Key (401 Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "kunci-rahasia-yang-salah"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos.php",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"]
            },
            "description": "Mengirim request dengan API Key yang salah. Menghasilkan respon HTTP 401 Unauthorized (Invalid API Key)."
          }
        },
        {
          "name": "3.3 Bearer Token Auth Format (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos.php",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"]
            },
            "description": "Menggunakan otentikasi format standar Bearer Token di Header Authorization."
          }
        },
        {
          "name": "3.4 Query Parameter Auth (200 OK)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos.php?api_key={{apiKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["todos.php"],
              "query": [
                {
                  "key": "api_key",
                  "value": "{{apiKey}}"
                }
              ]
            },
            "description": "Mengirimkan API Key melalui query parameter ?api_key=..."
          }
        }
      ]
    }
  ]
}
